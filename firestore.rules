rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(data) { return signedIn() && data.ownerId == request.auth.uid; }
    function ownerUnchanged() { return request.resource.data.ownerId == resource.data.ownerId; }
    function connectionUnchanged() {
      return request.resource.data.connectionId == resource.data.connectionId;
    }
    function ownsConnection(id) {
      return get(/databases/$(db)/documents/connections/$(id)).data.ownerId == request.auth.uid;
    }
    
    match /connections/{id} {
      allow read, delete: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data);
      allow update: if isOwner(resource.data) && ownerUnchanged();
    }

    match /contacts/{id} {
      allow read: if isOwner(resource.data);
      allow delete: if false;
      allow create: if isOwner(request.resource.data)
      && ownsConnection(request.resource.data.connectionId);
      allow update: if isOwner(resource.data) && ownerUnchanged() && connectionUnchanged();
    }

    match /messages/{id} {
      allow read, delete: if isOwner(resource.data);
      allow create, update: if false;
    }
  }
}